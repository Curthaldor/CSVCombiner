# Ignore Python virtual environments and bytecode
venv/
.venv/
env/
__pycache__/
*.py[cod]

# Output directories and their contents (keep these ignored)
output/

# Leave data folders tracked in the repo; do not ignore CSVs or input/massdata
# (remove broad CSV ignore to allow checking in sample/test data)

# Temporary PowerShell files
*.tmp
*.temp

# Ignore system files
Thumbs.db
.DS_Store

# Ignore IDE files
.vscode/
.idea/

# Ignore backup files
*.bak
*.backup
*~

# Ignore log files
*.log
